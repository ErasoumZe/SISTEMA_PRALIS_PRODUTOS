{
  "name": "@pralis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=dev tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "drizzle-kit push --config ./src/db/drizzle.config.ts --force && tsx src/db/ensure-creare-delivery-index.ts && tsx src/db/backfill-codigo-interno.ts && tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:push": "cross-env DOTENV_CONFIG_PATH=.env drizzle-kit push --config ./src/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./src/db/drizzle.config.ts",
    "gen:base": "tsx src/db/gen-base-json.ts",
    "seed:base": "tsx src/db/seed-base.ts",
    "backfill:codigo": "tsx src/db/backfill-codigo-interno.ts",
    "creare:depara": "cross-env DOTENV_CONFIG_PATH=.env tsx src/modules/creare/import-sia-depara.ts",
    "creare:pesavel:conciliar": "tsx scripts/reconciliar-pesavel-sia.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@pralis/shared": "file:../shared",
    "argon2": "^0.44.0",
    "cloudinary": "^2.9.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^6.1.0",
    "googleapis": "^176.0.0",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.22.0",
    "tsyringe": "^4.10.0",
    "uuidv7": "^1.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.9.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
