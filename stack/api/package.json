{
  "name": "@pralis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=dev tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "drizzle-kit push --config ./src/db/drizzle.config.ts --force && tsx src/db/seed-base.ts && tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "db:push": "cross-env DOTENV_CONFIG_PATH=.env drizzle-kit push --config ./src/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config ./src/db/drizzle.config.ts",
    "gen:base": "tsx src/db/gen-base-json.ts",
    "seed:base": "tsx src/db/seed-base.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@pralis/shared": "file:../shared",
    "argon2": "^0.44.0",
    "cloudinary": "^2.9.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.2",
    "fastify-type-provider-zod": "^6.1.0",
    "nanoid": "^5.1.6",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1",
    "tsyringe": "^4.10.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.9.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "xlsx": "^0.18.5"
  }
}
