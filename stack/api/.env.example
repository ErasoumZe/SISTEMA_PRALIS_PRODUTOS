# Banco (Postgres via docker-compose) — porta 5433 para não conflitar com outro Postgres
DB_USER=pralis
DB_PASSWORD=pralis
DB_NAME=pralis
DATABASE_URL=postgres://pralis:pralis@localhost:5433/pralis

# API
NODE_ENV=dev
PORT=3344
CORS_ORIGIN=*

# Autenticação (TROQUE em produção!)
JWT_SECRET=dev-jwt-secret-troque-em-producao
COOKIE_SECRET=dev-cookie-secret-troque-em-producao

# Cloudinary (foto do produto) — crie a conta e cole as credenciais do dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sheets (espelho na planilha oficial TNP/LI)
# Deixe DESLIGADO até a conta de serviço ter acesso de Editor à planilha.
GOOGLE_SHEETS_ENABLED=false
# OBRIGATÓRIO quando ENABLED=true e SEM valor padrão no código, de propósito:
# o destino da escrita é sempre decisão explícita de quem configura o ambiente.
# Ligar a integração sem informar este ID faz a sincronização ser RECUSADA
# (nada é escrito em lugar nenhum) em vez de cair em alguma planilha padrão.
# O destino OFICIAL definido em 16/09/2026 é a planilha
#   1xoPA6FqhLgix0cQSiyEgX56sO_X8QErz-9aZtrkGZAY  — aba "(TNP/LI) CADASTRO PRODUTOS"
# Ele fica aqui como COMENTÁRIO e não como valor: quem copia este arquivo para
# criar o seu `.env` e liga a integração passaria a escrever direto na planilha
# de produção sem ter decidido isso. Em homologação use uma CÓPIA descartável;
# em produção o valor é configurado no Coolify.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_BASE_TAB=(TNP/LI) CADASTRO PRODUTOS
GOOGLE_SHEETS_FISCAL_TAB=(TNP) FISCAL - DE PARA PRODUTOS
GOOGLE_SHEETS_GRUPO_IDS_TAB=TNP/LI/HORA - VLD EXP -  GRUPOS/REF (VLD)
GOOGLE_SHEETS_DEFAULT_LOJAS=TNP,LI,HORA
# Conta de serviço do Google Cloud (NÃO commitar o JSON de credenciais)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave inteira em uma linha; os "\n" literais são normalizados pela API
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Criare/SIA Supervisor — exportação manual do arquivo posicional.
# Mantenha desligado até o de-para da loja ser confirmado e homologado.
CREARE_EXPORT_ENABLED=false
# JSON em uma linha, por loja. Veja docs/integracao-creare.md para o formato.
CREARE_STORE_CONFIG_JSON=
# Token de máquina do robô do SIA, que roda agendado sem ninguém logado.
# Use um segredo aleatório com PELO MENOS 32 caracteres: abaixo disso a API
# recusa o caminho por token de propósito (503), em vez de enfraquecê-lo.
# O MESMO valor precisa existir na variável de ambiente `CREARE_EXPORT_TOKEN`
# da máquina da loja, que é de onde `automacao/robo-sia/baixar-cadastro.ps1` lê.
CREARE_EXPORT_TOKEN=

# Ingestão de vendas pelo robô. Use um segredo aleatório com pelo menos 32 caracteres.
# Sem este valor, chamadas automáticas por Bearer token permanecem desabilitadas.
VENDAS_IMPORT_TOKEN=
